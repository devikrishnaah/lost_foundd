<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Digital Return Receipt</title>
  <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;700&display=swap" rel="stylesheet">
  <style>
    body {
      font-family: 'Roboto', sans-serif;
      background: #f1edf1;
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh;
      margin: 0;
    }

    button {
      background-color: #4CAF50;
      color: rgb(255, 255, 255);
      border: none;
      padding: 12px 25px;
      font-size: 16px;
      border-radius: 8px;
      cursor: pointer;
      transition: background 0.3s;
    }

    button:hover {
      background-color: #45a049;
    }

    /* Modal styles */
    .modal {
      display: none;
      position: fixed;
      z-index: 1000;
      left: 0;
      top: 0;
      width: 100%;
      height: 100%;
      overflow: auto;
      background-color: rgba(0,0,0,0.5);
      opacity: 0;
      transition: opacity 0.3s ease;
      justify-content: center;
      align-items: center;
    }

    .modal.show {
      display: flex;
      opacity: 1;
    }

    .modal-content {
      background-color: #fff;
      border-radius: 10px;
      padding: 30px 40px;
      max-width: 400px;
      width: 90%;
      box-shadow: 0 8px 20px rgba(0,0,0,0.2);
      text-align: center;
      animation: fadeIn 0.3s ease;
    }

    @keyframes fadeIn {
      from {opacity:0; transform: translateY(-20px);}
      to {opacity:1; transform: translateY(0);}
    }

    .modal h2 {
      margin-bottom: 15px;
      color: #333;
    }

    .modal p {
      font-size: 16px;
      margin-bottom: 20px;
      color: #555;
      white-space: pre-line; /* Preserve line breaks */
    }

    .modal-buttons {
      display: flex;
      justify-content: center;
      gap: 15px;
      flex-wrap: wrap;
    }

    .close-btn {
      background-color: #f44336;
    }
  </style>
</head>
<body>

  <button id="generateReceiptBtn">Generate Receipt</button>

  <div id="receiptModal" class="modal">
    <div class="modal-content">
      <h2>Return Receipt</h2>
      <p id="receiptText"></p>
      <div class="modal-buttons">
        <button id="downloadTxtBtn">Download TXT</button>
        <button id="downloadPdfBtn">Download PDF</button>
        <button id="closeModalBtn" class="close-btn">Close</button>
      </div>
    </div>
  </div>

  <!-- jsPDF library for PDF download -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>

  <script>
    const modal = document.getElementById('receiptModal');
    const receiptText = document.getElementById('receiptText');
    const generateBtn = document.getElementById('generateReceiptBtn');
    const closeBtn = document.getElementById('closeModalBtn');
    const downloadTxtBtn = document.getElementById('downloadTxtBtn');
    const downloadPdfBtn = document.getElementById('downloadPdfBtn');

    // Function to format date nicely
    function formatDateTime(date) {
      return date.toLocaleString('en-US', {
        weekday: 'long', year: 'numeric', month: 'long',
        day: 'numeric', hour: 'numeric', minute: '2-digit',
        hour12: true
      });
    }

    generateBtn.addEventListener('click', () => {
      const userName = prompt("Please enter your name:");
      if(!userName) return;

      const now = new Date();
      const formattedDate = formatDateTime(now);

      const text = `Digital Return Receipt\n\nName: ${userName}\nDate: ${formattedDate}\n\nTHANK YOU.`;
      receiptText.textContent = text;

      modal.classList.add('show');
    });

    closeBtn.addEventListener('click', () => {
      modal.classList.remove('show');
    });

    downloadTxtBtn.addEventListener('click', () => {
      const blob = new Blob([receiptText.textContent], {type:'text/plain'});
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'return_receipt.txt';
      a.click();
      URL.revokeObjectURL(url);
    });

    downloadPdfBtn.addEventListener('click', () => {
      const { jsPDF } = window.jspdf;
      const doc = new jsPDF();
      const lines = receiptText.textContent.split('\n');
      let y = 20;
      lines.forEach(line => {
        doc.text(line, 20, y);
        y += 10;
      });
      doc.save('return_receipt.pdf');
    });
  </script>

</body>
</html>
